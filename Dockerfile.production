# STAGE 1: Builder
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# STAGE 2: Production Runtime
FROM node:18-alpine
WORKDIR /app

RUN addgroup -g 1000 -S kijani && adduser -u 1000 -S kijani -G kijani
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder --chown=kijani:kijani /app/dist ./dist
COPY --chown=kijani:kijani serverless ./serverless

RUN mkdir -p /var/lib/kijanikiosk/s3 && chown -R kijani:kijani /app /var/lib/kijanikiosk/s3

USER kijani
EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3001/health || exit 1

CMD ["node", "dist/index.js"]
